{
  "id": null,
  "uid": "ulpf-parse-ops",
  "title": "ULPF \u2014 Parse Operations",
  "tags": [
    "ulpf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Events Parsed",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ulpf_parsed_total)",
          "legendFormat": "Total Events Parsed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "NGRE vs Drain3",
      "type": "piechart",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ulpf_ngre_hits_total)",
          "legendFormat": "NGRE"
        },
        {
          "expr": "sum(ulpf_drain3_fallback_total)",
          "legendFormat": "Drain3"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "pie",
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Parse Errors",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ulpf_parse_errors_total)",
          "legendFormat": "Parse Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Windows \u2014 events/sec",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 10,
        "h": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ulpf_parsed_total{parser_id=~\"WIN-.*\"}[1m]))",
          "legendFormat": "events/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Windows \u2014 parse latency",
      "type": "timeseries",
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ulpf_parse_latency_seconds_bucket{parser_id=~\"WIN-.*\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ulpf_parse_latency_seconds_bucket{parser_id=~\"WIN-.*\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ulpf_parse_latency_seconds_bucket{parser_id=~\"WIN-.*\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Windows \u2014 NGRE hit-rate",
      "type": "gauge",
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(ulpf_ngre_hits_total{parser_id=~\"WIN-.*\"}) / clamp_min(sum(ulpf_parsed_total{parser_id=~\"WIN-.*\"}), 1)",
          "legendFormat": "Windows \u2014 NGRE hit-rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false
      }
    },
