  "ngre_pattern": "^(?P<date>\\d{4}-\\d{2}-\\d{2})\\s+(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+(?P<s_ip>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+(?P<method>GET|POST|PUT|DELETE|HEAD|OPTIONS|PATCH)\\s+(?P<uri_stem>\\S+)\\s+(?P<uri_query>\\S+)\\s+(?P<s_port>\\d+)\\s+(?P<username>\\S+)\\s+(?P<c_ip>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+(?P<user_agent>\\S+)\\s+(?P<http_status>\\d{3})\\s+(?P<substatus>\\d+)\\s+(?P<win32_status>\\d+)\\s+(?P<time_taken>\\d+)$",
